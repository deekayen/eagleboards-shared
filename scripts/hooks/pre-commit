#!/bin/sh
# Guard hook: refuse to commit participant data (PII) or secrets.
# Installed via: git config core.hooksPath scripts/hooks
#
# Same rules as the platform repos' hooks. Test cases added here must use
# synthetic people, and they are stored as JSON, never CSV.

fail=0

staged=$(git diff --cached --name-only --diff-filter=ACR)

for f in $staged; do
    case "$f" in
        *.csv|*.xls|*.xlsx|*.xlsm|*.ods)
            echo "BLOCKED: $f — spreadsheet/CSV files may contain participant data" >&2
            fail=1 ;;
    esac
    case "$f" in
        20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*)
            echo "BLOCKED: $f — dated event folders contain participant data" >&2
            fail=1 ;;
        *Board_Results*|Master_AdultHistory*|LOGIN_INFO*|.env)
            echo "BLOCKED: $f — contains PII or credentials" >&2
            fail=1 ;;
    esac
done

# Block a real SignUpGenius API key in staged content.
if git diff --cached -G'(-sugkey +|SIGNUP_GENIUS_KEY *= *")[A-Za-z0-9+/=]{16,}' --name-only | grep -q .; then
    echo "BLOCKED: staged content contains a SignUpGenius key" >&2
    fail=1
fi

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "Commit rejected by scripts/hooks/pre-commit. If this is a false" >&2
    echo "positive, adjust the hook — do not bypass with --no-verify." >&2
    exit 1
fi
exit 0
