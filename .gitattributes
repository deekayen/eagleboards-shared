# Line endings. Git for Windows checks text out with CRLF by default, so
# without these the checkin/ pages on a Windows machine would differ from
# every version's copy (all LF) and scripts/check-drift.sh would fail there.
* text=auto

checkin/**  text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.svg       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.sh        text eol=lf
scripts/hooks/*  text eol=lf

*.png       binary
